def M2GrammarCategory.name : M2GrammarCategory → String
  | .type => "τ"
  | .direction => "direction"
  | .r => "R"
  | .t => "t"
  | .rowDeclaration => "ρdecl"
  | .dep => "dep"
  | .role => "role"

def M2GrammarCategory.all : List M2GrammarCategory := [
  .type,
  .direction,
  .r,
  .t,
  .rowDeclaration,
  .dep,
  .role,
]

