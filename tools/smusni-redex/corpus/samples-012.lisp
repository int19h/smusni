; ro datka cu flulimna — CLL 10.19's bare capability reading
(Assert
  (CloseClause
    (StateClause
      (IndividualEvery {λ [$x :: Entity] (datka $x)}
        {λ [$duck :: Entity]
          (CloseClause
            (CapableClause (DirectClause (flulimna $duck))))}))))
